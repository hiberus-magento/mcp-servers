{
  "name": "@hiberus-magento/magento-cloud",
  "version": "0.1.1",
  "description": "MCP server and CLI wrapping the Magento Cloud CLI — read-only Adobe Commerce on Cloud projects, environments, deployment activities and bounded database diagnostics.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "adobe",
    "adobe-commerce",
    "magento",
    "magento-cloud",
    "commerce-cloud",
    "devops",
    "read-only"
  ],
  "homepage": "https://github.com/hiberus-magento/mcp-servers/tree/main/packages/magento-cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiberus-magento/mcp-servers.git",
    "directory": "packages/magento-cloud"
  },
  "bugs": {
    "url": "https://github.com/hiberus-magento/mcp-servers/issues"
  },
  "author": "Hiberus",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "hiberus-magento-cloud": "dist/cli.js",
    "hiberus-magento-cloud-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "verify:package": "node ../../scripts/verify-bundle.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','./LICENSE')\""
  },
  "dependencies": {},
  "devDependencies": {
    "@hiberus-magento/mcp-core": "workspace:*",
    "@hiberus-magento/mcp-testing": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "tsup": "^8.5.1",
    "zod": "^4.5.4"
  }
}
