{
  "name": "@hiberus-magento/eds",
  "version": "0.2.0",
  "description": "MCP server and CLI for the Adobe Edge Delivery Services (EDS) Admin API — publish state, site config, indexing, snapshots and the audit log.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "adobe",
    "edge-delivery-services",
    "eds",
    "aem",
    "aem-live",
    "admin-api",
    "publishing"
  ],
  "homepage": "https://github.com/hiberus-magento/mcp-servers/tree/main/packages/eds#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiberus-magento/mcp-servers.git",
    "directory": "packages/eds"
  },
  "bugs": {
    "url": "https://github.com/hiberus-magento/mcp-servers/issues"
  },
  "author": "Hiberus",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "hiberus-eds": "dist/cli.js",
    "hiberus-eds-mcp": "dist/mcp.js"
  },
  "exports": {
    "./config/catalog-views.js": "./src/config/catalog-views.ts"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "verify:package": "node ../../scripts/verify-bundle.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','./LICENSE')\""
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hiberus-magento/mcp-core": "workspace:*",
    "@hiberus-magento/mcp-testing": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "eslint": "10.10.0",
    "tsup": "^8.5.1",
    "typescript-eslint": "8.70.0",
    "zod": "^4.5.4"
  }
}
