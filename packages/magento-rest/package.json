{
  "name": "@hiberus-magento/magento-rest",
  "version": "0.0.0",
  "description": "MCP server and CLI for the Magento 2 REST API — catalog, orders, customers, stock and content reads, with opt-in write tools.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "magento",
    "magento2",
    "adobe-commerce",
    "rest-api",
    "ecommerce"
  ],
  "homepage": "https://github.com/hiberus-magento/mcp-servers/tree/main/packages/magento-rest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiberus-magento/mcp-servers.git",
    "directory": "packages/magento-rest"
  },
  "bugs": {
    "url": "https://github.com/hiberus-magento/mcp-servers/issues"
  },
  "author": "Hiberus",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "hiberus-magento-rest": "dist/cli.js",
    "hiberus-magento-rest-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "verify:package": "node ../../scripts/verify-bundle.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','./LICENSE')\""
  },
  "devDependencies": {
    "@hiberus-magento/mcp-core": "workspace:*",
    "@hiberus-magento/mcp-testing": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "mysql2": "3.24.6",
    "tsup": "^8.5.1",
    "zod": "^4.5.4"
  }
}
