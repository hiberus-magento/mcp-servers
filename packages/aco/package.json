{
  "name": "@hiberus-magento/aco",
  "version": "0.1.1",
  "description": "MCP server and CLI for Adobe Commerce Optimizer (ACO) — catalog search and facets on the Merchandising API, catalog views, price books and policies on the admin API.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "adobe",
    "adobe-commerce",
    "commerce-optimizer",
    "aco",
    "merchandising",
    "catalog-search",
    "ecommerce"
  ],
  "homepage": "https://github.com/hiberus-magento/mcp-servers/tree/main/packages/aco#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiberus-magento/mcp-servers.git",
    "directory": "packages/aco"
  },
  "bugs": {
    "url": "https://github.com/hiberus-magento/mcp-servers/issues"
  },
  "author": "Hiberus",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "hiberus-aco": "dist/cli.js",
    "hiberus-aco-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "verify:package": "node ../../scripts/verify-bundle.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','./LICENSE')\""
  },
  "dependencies": {},
  "devDependencies": {
    "@hiberus-magento/eds": "workspace:*",
    "@hiberus-magento/mcp-core": "workspace:*",
    "@hiberus-magento/mcp-testing": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "graphql": "^17.0.2",
    "tsup": "^8.5.1",
    "zod": "^4.5.4"
  }
}
