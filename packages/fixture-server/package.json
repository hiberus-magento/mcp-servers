{
  "name": "@hiberus-magento/fixture-server",
  "private": true,
  "version": "0.0.0",
  "description": "MCP server for the testing domain. Replace this description before publishing — npm shows it under the package name in search results.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "adobe",
    "testing"
  ],
  "homepage": "https://github.com/hiberus-magento/mcp-servers/tree/main/packages/fixture-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiberus-magento/mcp-servers.git",
    "directory": "packages/fixture-server"
  },
  "bugs": {
    "url": "https://github.com/hiberus-magento/mcp-servers/issues"
  },
  "author": "Hiberus",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "fixture-server": "dist/server.js"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "verify:package": "node ../../scripts/verify-bundle.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','./LICENSE')\""
  },
  "dependencies": {},
  "devDependencies": {
    "@hiberus-magento/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "tsup": "^8.5.1",
    "zod": "^4.5.4"
  }
}
