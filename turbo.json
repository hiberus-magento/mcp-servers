{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "verify:package": {
      "dependsOn": ["build"],
      "inputs": ["dist/**"]
    }
  }
}
